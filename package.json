{
  "name": "goodscan",
  "version": "1.0.0",
  "private": true,
  "description": "Health scanner for food in your browser: scan a barcode, get a clear 0–100 verdict from Open Food Facts, in the US, France, Germany and worldwide.",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit -p .",
    "lint": "biome check .",
    "format": "biome check --write .",
    "test": "bun test src",
    "test:e2e": "bun run build && playwright test",
    "e2e-live": "bun test e2e-live",
    "catalog": "llm-models catalog --npm callable --require openai,anthropic,google,mistral --out public/models.json",
    "additives": "bun scripts/additives.ts",
    "fixtures": "bun scripts/fixtures.ts",
    "attributes": "bun scripts/attributes.ts",
    "hazards": "bun scripts/hazards.ts",
    "icons": "pwa-assets-generator"
  },
  "dependencies": {
    "@ai-sdk/anthropic": "4.0.87",
    "@ai-sdk/google": "4.0.104",
    "@ai-sdk/mistral": "4.0.71",
    "@ai-sdk/openai": "4.0.101",
    "@ai-sdk/openai-compatible": "3.0.77",
    "ai": "7.0.152",
    "barcode-detector": "3.2.3",
    "idb": "8.0.4",
    "llm-connect": "2.5.0",
    "llm-models": "1.14.0",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "zod": "4.6.7",
    "zxing-wasm": "3.1.6"
  },
  "devDependencies": {
    "@biomejs/biome": "2.6.2",
    "@playwright/test": "1.64.1",
    "@tailwindcss/vite": "4.3.3",
    "@types/bun": "1.4.4",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vite-pwa/assets-generator": "1.0.0",
    "@vitejs/plugin-react": "6.1.2",
    "tailwindcss": "4.3.3",
    "typescript": "7.0.2",
    "vite": "8.3.5",
    "vite-plugin-pwa": "2.0.0",
    "workbox-window": "7.4.1"
  }
}
